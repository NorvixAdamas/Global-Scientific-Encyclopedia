# =============================================================================
# Global Scientific Encyclopedia V2.0 — environment template
# =============================================================================
# IMPORTANT: the website is a static site. It does NOT read these variables at
# runtime in the browser. Browser-side optional keys are entered by the visitor
# on the "#/settings" page and stored in that browser's localStorage.
#
# This file documents the variables used ONLY by the optional Netlify Function
# proxy (netlify/functions/api.js), which keeps keys on the server so that a
# deployed site can query key-gated sources without exposing them.
#
# Copy to `.env` for local Netlify Dev testing and fill in your own values.
# NEVER commit `.env`, never paste real keys into chat or documentation.
# =============================================================================

# --- Optional: server-side proxy (Netlify Function) -------------------------
# Base URL the front end should call instead of the upstream APIs.
# In the browser settings page, set "Proxy URL" to the same value.
# Example: https://your-site.netlify.app/.netlify/functions/api
SCI_PROXY_BASE=

# Materials Project (free account). Required only for the materials live panel.
# https://next-gen.materialsproject.org/api
MP_API_KEY=

# openFDA (free, optional; raises the daily quota).
# https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# NCBI E-utilities (free, optional; raises requests/second).
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Contact email for the Crossref polite pool (optional).
CROSSREF_MAILTO=

# --- Notes ------------------------------------------------------------------
# * No paid service is used by this project.
# * The static site works with none of these variables set.
# * Netlify environment variables are visible to Functions, not to the browser,
#   unless a function deliberately returns them (this project never does).
